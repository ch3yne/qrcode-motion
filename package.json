{
  "name": "qrcode-motion",
  "version": "0.1.1",
  "description": "Animated QR code for React: cascading characters resolve into a scannable code, with an optional center logo.",
  "keywords": [
    "qrcode",
    "qr-code",
    "qr",
    "react",
    "react-component",
    "qrcode-logo",
    "qrlogo",
    "logo",
    "animation",
    "animated",
    "canvas",
    "motion",
    "qr-motion",
    "qrcode-animation",
    "custom",
    "styling",
    "typescript"
  ],
  "author": "cheyne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ch3yne/qrcode-motion.git"
  },
  "homepage": "https://github.com/ch3yne/qrcode-motion#readme",
  "bugs": {
    "url": "https://github.com/ch3yne/qrcode-motion/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/react/index.cjs",
  "module": "./dist/react/index.js",
  "types": "./dist/react/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --port 5183",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/build-dts.mjs && node scripts/postbuild.mjs && node scripts/check-dist.mjs",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "publint && attw --pack . --profile node16",
    "size": "size-limit",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm run test && npm run build:lib && npm run check:package",
    "prepublishOnly": "npm run typecheck && npm run build:lib"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup-plugin-dts": "^6.5.1",
    "size-limit": "^14.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.0.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
